# Copy to .env.local and fill with real values (never commit real values).
# Real values live in credentials.json on this machine and in Vercel project settings.

# Public site URL (used for sitemap, robots, OpenGraph metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Convex
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Secret for verifying Clerk webhooks (Dashboard > Webhooks > Signing secret)
CLERK_WEBHOOK_SECRET=

# Paystack (server-only). NEVER prefix with NEXT_PUBLIC_.
# Scripts/check-payments.mjs reports whether the key is test or live.
# PAYSTACK_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Renewal links for M-Pesa subscriptions fall back to this URL.
# Set to your public app URL in production, e.g. https://gigi.energy/subscribe/thanks
# RENEWAL_CALLBACK_URL=

# Transactional email (Resend). Set these on the CONVEX deployment
# (`npx convex env set RESEND_API_KEY=...`), not only in .env.local — senders
# run inside Convex. Without RESEND_API_KEY every send is logged and skipped.
# RESEND_API_KEY=
# EMAIL_FROM="GiGi Energy <hello@gigi.energy>"
# EMAIL_REPLY_TO=hello@gigi.energy
# ADMIN_EMAIL=ops@gigi.energy

# Where client error reports are forwarded (Slack/Discord webhook). Optional.
# ERROR_WEBHOOK_URL=
